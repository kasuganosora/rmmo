; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rmmo"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

MockServer="*res://scripts/net/mock_server.gd"
GameSession="*res://scripts/net/game_session.gd"
AssetManager="*res://scripts/asset/asset_manager.gd"
GameSettings="*res://scripts/game/game_settings.gd"
ServerConnection="*res://scripts/net/server_connection.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=2560
window/size/window_height_override=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/silence_type_safe_gutter/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/use_taa=true

[rmmo]

network/use_real_server=false
network/server_url="http://127.0.0.1:7777"
network/request_timeout_sec=10.0
network/movement_hz=20.0
network/map_paths={}
mock/latency_sec=0.35
mock/ai_tick_interval_sec=0.45
mock/combat_tick_interval_sec=1.5
mock/chunk_view_radius_m=12.0
content_root="/workspace/rmmo_runtime"
charset_root="/workspace/rmmo_runtime/assets/charset"
default_pack="default"
entry_map="medieval_material_house"
ui_pack="default"
characters_3d=true
startup_profile="world3d"
