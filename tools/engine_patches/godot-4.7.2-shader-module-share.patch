+void RenderingDeviceDriverVulkan::rmmo_release_module(ShaderInfo &p_shader, uint32_t p_index) {
+	VkShaderModule module = p_shader.vk_stages_create_info[p_index].module;
+	if (module == VK_NULL_HANDLE) return;
+	auto destroy = [&](VkShaderModule m) { vkDestroyShaderModule(vk_device, m, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SHADER_MODULE)); };
+	if (p_index < p_shader.rmmo_shared_modules.size()) {
+		rmmo_module_registry.release(p_shader.rmmo_shared_modules[p_index], module, destroy);
+		p_shader.rmmo_shared_modules[p_index] = nullptr;
+	} else {
+		destroy(module);
+	}
+	p_shader.vk_stages_create_info[p_index].module = VK_NULL_HANDLE;
+}
