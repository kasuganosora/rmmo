@@ -0,0 +1,48 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+// Driver-local active-owner cache. Hash is only a bucket hint; bytes decide.
+template<class Handle> class ModuleRegistry {
+public:
+ struct Entry { std::vector<uint8_t> bytes; Handle handle{}; uint64_t hash=0; uint32_t refs=0; };
+ struct Stats { uint64_t hits,misses,created,failures,over_cap,releases,retained,peak,live,peak_live,entry_metadata,peak_entry_metadata,entry_size,cap_bytes,cap_entries; };
+private:
+ std::mutex mutex;
+ std::unordered_map<uint64_t,std::vector<Entry*>> buckets;
+ uint64_t max_bytes,max_entries;
+ uint64_t hits=0,misses=0,created=0,failures=0,over_cap=0,releases=0,retained=0,peak=0,live=0,peak_live=0;
+public:
+ ModuleRegistry(uint64_t byte_cap,uint64_t entry_cap):max_bytes(byte_cap),max_entries(entry_cap){}
+ bool set_test_limits(uint64_t bytes,uint64_t entries){std::lock_guard<std::mutex> lock(mutex);if(live)return false;max_bytes=bytes;max_entries=entries;return true;}
+ // create is invoked under this independent registry lock; never acquire the RD lock inside it.
+ template<class Create> bool acquire(const uint8_t *data,size_t len,uint64_t hash,Create create,Handle &handle,Entry *&entry) {
+  std::unique_lock<std::mutex> lock(mutex);entry=nullptr;
+  auto it=buckets.find(hash);
+  if(it!=buckets.end())for(Entry *e:it->second)if(e->bytes.size()==len && !std::memcmp(e->bytes.data(),data,len)) { e->refs++;handle=e->handle;entry=e;hits++;return true; }
+  misses++;
+  if(len>max_bytes-retained || live>=max_entries) { over_cap++;lock.unlock();return create(handle); }
+  Entry *e=new Entry;e->bytes.assign(data,data+len);
+  const uint64_t alloc=e->bytes.capacity();
+  if(alloc>max_bytes-retained) { delete e;over_cap++;lock.unlock();return create(handle); }
+  if(!create(handle)) { delete e;failures++;return false; }
+  e->handle=handle;e->hash=hash;e->refs=1;entry=e;buckets[hash].push_back(e);
+  retained+=alloc;live++;created++;if(retained>peak)peak=retained;if(live>peak_live)peak_live=live;
+  return true;
+ }
+ template<class Destroy> void release(Entry *entry,Handle handle,Destroy destroy) {
+  if(!entry){ destroy(handle);return; }
+  std::unique_lock<std::mutex> lock(mutex);releases++;
+  if(--entry->refs)return;
+  auto it=buckets.find(entry->hash);auto &v=it->second;
+  for(auto i=v.begin();i!=v.end();++i)if(*i==entry){v.erase(i);break;}
+  if(v.empty())buckets.erase(it);const uint64_t bytes=entry->bytes.capacity();Handle last=entry->handle;delete entry;retained-=bytes;live--;lock.unlock();
+  destroy(last);
+ }
+ Stats stats(){std::lock_guard<std::mutex> lock(mutex);return {hits,misses,created,failures,over_cap,releases,retained,peak,live,peak_live,live*sizeof(Entry),peak_live*sizeof(Entry),sizeof(Entry),max_bytes,max_entries};}
+};
