+#pragma once
+
+#include "core/object/ref_counted.h"
+#include "core/os/condition_variable.h"
+#include "core/os/mutex.h"
+#include "core/templates/hash_set.h"
+#include "core/templates/vector.h"
+#include "core/variant/dictionary.h"
+
+// An independent completion owner, not a borrowed WorkerThreadPool task ID.
+// The compiler signals only after the creation callback has returned.
+class PipelineCompilationCompletion : public RefCounted {
+    mutable BinaryMutex mutex;
+    ConditionVariable condition;
+    bool completed = false;
+public:
+    void mark_completed();
+    bool is_completed() const;
+    void wait();
+};
+
+// Short-lived, thread-local native-load scope. Material owners never escape
+// into the CPU capture returned to gameplay. Finish also runs on read failure.
+class PipelineCompilationBatch {
+    static thread_local PipelineCompilationBatch *current;
+    PipelineCompilationBatch *previous = nullptr;
+    bool active = false;
+    bool finished = false;
+    HashSet<ObjectID> material_ids;
+    Vector<Ref<RefCounted>> materials;
+    HashSet<ObjectID> completion_ids;
+    Vector<Ref<PipelineCompilationCompletion>> completions;
+    uint64_t requests = 0;
+    uint64_t unique_completions = 0;
+    uint64_t unique_materials = 0;
+    uint64_t pending_at_finish = 0;
+    uint64_t wait_usec = 0;
+public:
+    static bool is_enabled();
+    static PipelineCompilationBatch *get_current() { return current; }
+    void retain_material(const Ref<RefCounted> &p_material);
+    void add_completion(const Ref<PipelineCompilationCompletion> &p_completion);
+    void finish();
+    Dictionary get_statistics() const;
+    PipelineCompilationBatch();
+    ~PipelineCompilationBatch();
+};
