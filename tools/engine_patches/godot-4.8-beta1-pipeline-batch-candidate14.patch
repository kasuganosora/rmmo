+#include "pipeline_compilation_batch.h"
+
+#include "core/object/worker_thread_pool.h"
+#include "core/os/os.h"
+#include "core/os/thread.h"
+
+void PipelineCompilationCompletion::mark_completed() {
+    MutexLock lock(mutex);
+    completed = true;
+    condition.notify_all();
+}
+
+bool PipelineCompilationCompletion::is_completed() const {
+    MutexLock lock(mutex);
+    return completed;
+}
+
+void PipelineCompilationCompletion::wait() {
+    MutexLock lock(mutex);
+    while (!completed) {
+        condition.wait(lock);
+    }
+}
+
+thread_local PipelineCompilationBatch *PipelineCompilationBatch::current = nullptr;
+
+bool PipelineCompilationBatch::is_enabled() {
+    static const bool enabled = OS::get_singleton()->get_environment("RMMO_BATCH_MESH_PIPELINES") == "1";
+    return enabled;
+}
+
+PipelineCompilationBatch::PipelineCompilationBatch() {
+    // Condition-variable waiting is restricted to the private reader thread.
+    // Pool tasks retain the existing collaborative wait; main keeps normal API
+    // behavior. This cannot consume all compiler workers waiting on themselves.
+    active = is_enabled() && !Thread::is_main_thread() && WorkerThreadPool::get_singleton()->get_thread_index() == -1;
+    if (active) {
+        previous = current;
+        current = this;
+    }
+}
+
+void PipelineCompilationBatch::retain_material(const Ref<RefCounted> &p_material) {
+    if (p_material.is_null() || material_ids.has(p_material->get_instance_id())) {
+        return;
+    }
+    material_ids.insert(p_material->get_instance_id());
+    materials.push_back(p_material);
+}
+
+void PipelineCompilationBatch::add_completion(const Ref<PipelineCompilationCompletion> &p_completion) {
+    ++requests;
+    if (p_completion.is_null() || completion_ids.has(p_completion->get_instance_id())) {
+        return;
+    }
+    completion_ids.insert(p_completion->get_instance_id());
+    completions.push_back(p_completion);
+}
+
+void PipelineCompilationBatch::finish() {
+    if (!active || finished) {
+        return;
+    }
+    finished = true;
+    current = previous;
+    unique_completions = completions.size();
+    unique_materials = materials.size();
+    for (const Ref<PipelineCompilationCompletion> &completion : completions) {
+        pending_at_finish += !completion->is_completed();
+    }
+    const uint64_t began = OS::get_singleton()->get_ticks_usec();
+    for (const Ref<PipelineCompilationCompletion> &completion : completions) {
+        completion->wait();
+    }
+    wait_usec = OS::get_singleton()->get_ticks_usec() - began;
+    // Even a failed read cannot destroy a compiler's material until its
+    // callback has returned. These owners are gone before handing off capture.
+    materials.clear();
+    material_ids.clear();
+    completions.clear();
+    completion_ids.clear();
+}
+
+Dictionary PipelineCompilationBatch::get_statistics() const {
+    Dictionary data;
+    data["enabled"] = active;
+    data["requests"] = int64_t(requests);
+    data["unique_completions"] = int64_t(unique_completions);
+    data["material_owners"] = int64_t(unique_materials);
+    data["pending_at_finish"] = int64_t(pending_at_finish);
+    data["wait_usec"] = int64_t(wait_usec);
+    data["remaining_material_owners"] = materials.size();
+    data["remaining_completions"] = completions.size();
+    return data;
+}
+
+PipelineCompilationBatch::~PipelineCompilationBatch() {
+    finish();
+}
