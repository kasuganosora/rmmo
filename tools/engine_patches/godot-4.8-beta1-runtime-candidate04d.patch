+#pragma once
+
+#include "core/object/ref_counted.h"
+#include "core/os/mutex.h"
+#include "core/templates/hash_map.h"
+#include "servers/rendering/rendering_server_types.h"
+
+class ArrayMesh;
+
+// Per private native load. Owns only temporary CPU buffers, never scene/GPU
+// resources. Consumer must close on its preparation/retirement thread.
+// take() requires an exclusively owned, immutable private mesh. Revision
+// checks reject sequential edits; they do not synchronize concurrent mesh
+// mutation. Only session close/statistics may run concurrently with take().
+class NativeMeshCpuCapture : public RefCounted {
+	GDCLASS(NativeMeshCpuCapture, RefCounted);
+
+	struct Entry {
+		Vector<RenderingServerTypes::SurfaceData> surfaces;
+		uint64_t revision = 0;
+		uint64_t bytes = 0;
+	};
+	mutable Mutex mutex;
+	HashMap<ObjectID, Entry> entries;
+	bool closed = false;
+	uint64_t pending_bytes = 0;
+	uint64_t inflight_bytes = 0;
+	uint64_t peak_bytes = 0;
+	uint64_t recorded_meshes = 0;
+	uint64_t decoded_meshes = 0;
+	uint64_t decoded_surfaces = 0;
+	uint64_t discarded_meshes = 0;
+	uint64_t skipped_meshes = 0;
+	uint64_t duplicate_records = 0;
+	uint64_t missing_takes = 0;
+	uint64_t decode_usec = 0;
+
+	static bool _eligible(const ArrayMesh *p_mesh, const Vector<RenderingServerTypes::SurfaceData> &p_surfaces);
+	static bool _valid_lengths(const RenderingServerTypes::SurfaceData &p_surface);
+	static uint64_t _payload_bytes(const RenderingServerTypes::SurfaceData &p_surface);
+
+protected:
+	static void _bind_methods();
+
+public:
+	static Dictionary load_native_scene(const String &p_path);
+	void record(ArrayMesh *p_mesh, const Vector<RenderingServerTypes::SurfaceData> &p_surfaces);
+	Dictionary take(const Ref<ArrayMesh> &p_mesh);
+	void close();
+	Dictionary get_statistics() const;
+	~NativeMeshCpuCapture();
+};
