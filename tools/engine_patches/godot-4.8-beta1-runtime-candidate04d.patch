+#include "servers/rendering/rendering_server.h"
+
+bool NativeMeshCpuCapture::_eligible(const ArrayMesh *p_mesh, const Vector<RenderingServerTypes::SurfaceData> &p_surfaces) {
+	if (p_mesh->get_blend_shape_count() != 0 || p_mesh->is_local_to_scene() || p_surfaces.is_empty()) {
+		return false;
+	}
+	for (const RenderingServerTypes::SurfaceData &surface : p_surfaces) {
+		const uint64_t excluded = RSE::ARRAY_FORMAT_BONES | RSE::ARRAY_FORMAT_WEIGHTS | RSE::ARRAY_FLAG_USE_2D_VERTICES | RSE::ARRAY_FLAG_USE_DYNAMIC_UPDATE;
+		if (surface.primitive != RSE::PRIMITIVE_TRIANGLES || (surface.format & excluded) || !surface.skin_data.is_empty() || !surface.blend_shape_data.is_empty()) {
+			return false;
+		}
+	}
+	return true;
+}
+
+uint64_t NativeMeshCpuCapture::_payload_bytes(const RenderingServerTypes::SurfaceData &p_surface) {
+	uint64_t size = uint64_t(p_surface.vertex_data.size()) + p_surface.attribute_data.size() + p_surface.skin_data.size() + p_surface.index_data.size() + p_surface.blend_shape_data.size();
+	for (const RenderingServerTypes::SurfaceData::LOD &lod : p_surface.lods) {
+		size += lod.index_data.size();
+	}
+	return size;
+}
+
+bool NativeMeshCpuCapture::_valid_lengths(const RenderingServerTypes::SurfaceData &p_surface) {
+	// Bounds checks for decoder memory safety only; never scan trusted indices.
+	if (p_surface.vertex_count <= 0 || p_surface.index_count < 0) {
+		return false;
+	}
+	RenderingServer *rs = RenderingServer::get_singleton();
+	const uint64_t vertices = p_surface.vertex_count;
+	const uint64_t vertex_stride = rs->mesh_surface_get_format_vertex_stride(p_surface.format, p_surface.vertex_count);
+	const uint64_t normal_stride = rs->mesh_surface_get_format_normal_tangent_stride(p_surface.format, p_surface.vertex_count);
+	const uint64_t attribute_stride = rs->mesh_surface_get_format_attribute_stride(p_surface.format, p_surface.vertex_count);
+	const uint64_t index_stride = rs->mesh_surface_get_format_index_stride(p_surface.format, p_surface.vertex_count);
+	if (uint64_t(p_surface.vertex_data.size()) < (vertex_stride + normal_stride) * vertices || uint64_t(p_surface.attribute_data.size()) < attribute_stride * vertices || uint64_t(p_surface.index_data.size()) < index_stride * uint64_t(p_surface.index_count)) {
+		return false;
+	}
+	for (const RenderingServerTypes::SurfaceData::LOD &lod : p_surface.lods) {
+		if (index_stride == 0 || uint64_t(lod.index_data.size()) % index_stride != 0) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void NativeMeshCpuCapture::record(ArrayMesh *p_mesh, const Vector<RenderingServerTypes::SurfaceData> &p_surfaces) {
+	if (!_eligible(p_mesh, p_surfaces)) {
+		MutexLock lock(mutex);
+		++skipped_meshes;
+		return;
+	}
+	Entry entry;
+	entry.surfaces = p_surfaces; // COW buffer references; no byte-array clone.
+	entry.revision = p_mesh->get_cpu_geometry_revision();
+	for (int i = 0; i < entry.surfaces.size(); ++i) {
+		entry.surfaces.write[i].material = RID();
+		entry.bytes += _payload_bytes(entry.surfaces[i]);
+	}
+	Entry replaced;
+	{
+		MutexLock lock(mutex);
+		if (closed) {
+			return;
+		}
+		Entry *previous = entries.getptr(p_mesh->get_instance_id());
+		if (previous) {
+			++duplicate_records;
+			pending_bytes -= previous->bytes;
+			replaced = std::move(*previous);
+			entries.erase(p_mesh->get_instance_id());
+		}
+		pending_bytes += entry.bytes;
+		peak_bytes = MAX(peak_bytes, pending_bytes + inflight_bytes);
+		entries.insert(p_mesh->get_instance_id(), std::move(entry));
+		++recorded_meshes;
+	}
+	// A replaced payload is destroyed after the map lock has been released.
+}
+
+Dictionary NativeMeshCpuCapture::take(const Ref<ArrayMesh> &p_mesh) {
+	Dictionary result;
+	if (p_mesh.is_null()) {
+		result["status"] = "invalid_mesh";
+		return result;
+	}
+	Entry entry;
+	{
+		MutexLock lock(mutex);
+		if (closed) {
+			result["status"] = "closed";
+			return result;
+		}
+		Entry *found = entries.getptr(p_mesh->get_instance_id());
+		if (!found) {
+			++missing_takes;
+			result["status"] = "missing";
+			return result;
+		}
+		entry = std::move(*found);
+		entries.erase(p_mesh->get_instance_id());
+		pending_bytes -= entry.bytes;
+		inflight_bytes += entry.bytes;
+	}
+
+	String status = "ok";
+	Array arrays;
+	Array lods;
+	uint64_t surface_count = 0;
+	const uint64_t began = OS::get_singleton()->get_ticks_usec();
+	if (entry.revision != p_mesh->get_cpu_geometry_revision() || entry.surfaces.size() != p_mesh->get_surface_count()) {
+		status = "stale";
+	} else if (!_eligible(p_mesh.ptr(), entry.surfaces)) {
+		status = "unsupported";
+	} else {
+		for (int i = 0; i < entry.surfaces.size(); ++i) {
+			{
+				MutexLock lock(mutex);
+				if (closed) {
+					status = "closed";
+					break;
+				}
+			}
+			if (!_valid_lengths(entry.surfaces[i])) {
+				status = "decode_error";
+				break;
+			}
+			Array decoded = RenderingServer::get_singleton()->mesh_create_arrays_from_surface_data(entry.surfaces[i]);
+			if (decoded.size() != RSE::ARRAY_MAX) {
+				status = "decode_error";
+				break;
+			}
+			arrays.push_back(decoded);
+			lods.push_back(RenderingServer::get_singleton()->mesh_create_lods_from_surface_data(entry.surfaces[i]));
+			entry.surfaces.write[i] = RenderingServerTypes::SurfaceData();
+			++surface_count;
+		}
+	}
+	entry.surfaces.clear(); // No compressed input survives a completed take.
+	if (status == "ok" && entry.revision != p_mesh->get_cpu_geometry_revision()) {
+		status = "stale";
+	}
+	{
+		MutexLock lock(mutex);
+		inflight_bytes -= entry.bytes;
+		decode_usec += OS::get_singleton()->get_ticks_usec() - began;
+		decoded_surfaces += surface_count;
+		if (closed) {
+			status = "closed";
+		}
+		if (status == "ok") {
+			++decoded_meshes;
+		} else {
+			++discarded_meshes;
+		}
+	}
+	result["status"] = status;
+	if (status == "ok") {
+		result["revision"] = int64_t(entry.revision);
+		result["arrays"] = arrays;
+		result["lods"] = lods;
+		result["retained_payload_bytes"] = int64_t(entry.bytes);
+	}
+	return result;
+}
+
+void NativeMeshCpuCapture::close() {
+	HashMap<ObjectID, Entry> discarded;
+	{
+		MutexLock lock(mutex);
+		closed = true;
+		discarded_meshes += entries.size();
+		pending_bytes = 0;
+		discarded = std::move(entries);
+	}
+	// CPU-only payload destruction outside the lock. Active takes own their
+	// buffers until their next surface boundary; their bytes remain accounted.
+}
+
+Dictionary NativeMeshCpuCapture::get_statistics() const {
+	MutexLock lock(mutex);
+	Dictionary data;
+	data["closed"] = closed;
+	data["pending_meshes"] = entries.size();
+	data["pending_payload_bytes"] = int64_t(pending_bytes);
+	data["inflight_payload_bytes"] = int64_t(inflight_bytes);
+	data["peak_payload_bytes"] = int64_t(peak_bytes);
+	data["recorded_meshes"] = int64_t(recorded_meshes);
+	data["decoded_meshes"] = int64_t(decoded_meshes);
+	data["decoded_surfaces"] = int64_t(decoded_surfaces);
+	data["discarded_meshes"] = int64_t(discarded_meshes);
+	data["skipped_meshes"] = int64_t(skipped_meshes);
+	data["duplicate_records"] = int64_t(duplicate_records);
+	data["missing_takes"] = int64_t(missing_takes);
+	data["decode_usec"] = int64_t(decode_usec);
+	return data;
+}
+
+Dictionary NativeMeshCpuCapture::load_native_scene(const String &p_path) {
+	Ref<NativeMeshCpuCapture> capture;
+	capture.instantiate();
+	Error error = ERR_FILE_UNRECOGNIZED;
+	Ref<Resource> resource;
+	const String extension = p_path.get_extension().to_lower();
+	if (extension == "scn" || extension == "tscn") {
+		resource = ResourceLoader::load_with_preparation_context(p_path, "PackedScene", ResourceLoader::CACHE_MODE_IGNORE_DEEP, capture, &error);
+		if (error == OK && Object::cast_to<PackedScene>(resource.ptr()) == nullptr) {
+			error = ERR_INVALID_DATA;
+		}
+	}
+	if (error != OK) {
+		capture->close();
+	}
+	Dictionary packet;
+	packet["error"] = error;
+	packet["resource"] = resource;
+	packet["capture"] = capture;
+	return packet;
+}
+
+void NativeMeshCpuCapture::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("take", "mesh"), &NativeMeshCpuCapture::take);
+	ClassDB::bind_method(D_METHOD("close"), &NativeMeshCpuCapture::close);
+	ClassDB::bind_method(D_METHOD("get_statistics"), &NativeMeshCpuCapture::get_statistics);
+}
+
+NativeMeshCpuCapture::~NativeMeshCpuCapture() {
+	close();
+}
