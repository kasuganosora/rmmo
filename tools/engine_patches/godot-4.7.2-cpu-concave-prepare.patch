+#pragma once
+
+#include "godot_shape_3d.h"
+#include "core/object/ref_counted.h"
+
+// Immutable, CPU-only result. The private shape has no RID, world, or owners.
+// It runs the exact ordinary BVH builder, then shares the completed COW vectors.
+class GodotConcavePreparedData3D : public RefCounted {
+    GDCLASS(GodotConcavePreparedData3D, RefCounted);
+protected:
+    static void _bind_methods() {}
+public:
+    GodotConcavePolygonShape3D shape;
+    Vector<Vector3> source_faces;
+    static Dictionary prepare(const Vector<Vector3> &p_faces, bool p_backface_collision) {
+        ERR_FAIL_COND_V(p_faces.size() % 3, Dictionary());
+        Ref<GodotConcavePreparedData3D> prepared;
+        prepared.instantiate();
+        prepared->source_faces = p_faces;
+        prepared->shape._setup(p_faces, p_backface_collision);
+        Dictionary data;
+        data["faces"] = p_faces;
+        data["backface_collision"] = p_backface_collision;
+        data["_prepared"] = prepared;
+        return data;
+    }
+};
