diff --git a/core/debugger/rmmo_debug_trace_script.h b/core/debugger/rmmo_debug_trace_script.h
new file mode 100644
--- /dev/null
+++ b/core/debugger/rmmo_debug_trace_script.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "rmmo_debug_trace.h"
+#include "rmmo_debug_trace_tasks.h"
+
+// Trace-only: no retained script/Variant/Resource owners; ordinary calls are
+// not instrumented. Metadata is made only after an active capture accepted
+// a span. Context is separate from native Object lifetime task names.
+namespace RmmoDebugTrace {
+enum ScriptLabel {
+	SCRIPT_SIGNAL_CALLBACK = 117,
+	SCRIPT_RESUME,
+	SCRIPT_RESUME_LOCK,
+	SCRIPT_CLEAR,
+	SCRIPT_CLEAR_CONNECTIONS,
+	SCRIPT_CLEAR_STACK,
+	SCRIPT_COMPLETED,
+	SCRIPT_EXIT,
+	SCRIPT_STACK_RELEASE,
+};
+class ScriptScope {
+    uint64_t span;
+public:
+    ScriptScope(uint32_t label, int64_t task, bool enabled = true) :
+            span(enabled ? begin(label, task, -249) : 0) {}
+    template <typename Path, typename Name>
+    ScriptScope(uint32_t label, int64_t task, const Path &path, const Name &name) :
+            span(begin(label, task, -249)) {
+        if (span) name_task(task, -249, String(path) + "::" + String(name));
+    }
+    ~ScriptScope() { if (span) end(span); }
+    ScriptScope(const ScriptScope &) = delete;
+    ScriptScope &operator=(const ScriptScope &) = delete;
+};
+}
