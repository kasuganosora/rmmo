+void BaseMaterial3D::_reference_shader(ShaderData *p_shader) {
+	if (p_shader->unused) {
+		unused_shaders.erase(p_shader->unused);
+		p_shader->unused = nullptr;
+		rmmo_shader_reused++;
+	}
+	p_shader->users++;
+}
+
+void BaseMaterial3D::_release_shader(const MaterialKey &p_key) {
+	ShaderData *v = shader_map.getptr(p_key);
+	if (!v) {
+		return;
+	}
+	ERR_FAIL_COND(v->users <= 0);
+	if (--v->users > 0) {
+		return;
+	}
+	if (!shader_cache_active || unused_shader_limit == 0) {
+		RS::get_singleton()->free_rid(v->shader);
+		shader_map.erase(p_key);
+		return;
+	}
+	v->unused = unused_shaders.push_back(p_key);
+	while (unused_shaders.size() > unused_shader_limit) {
+		MaterialKey key = unused_shaders.front()->get();
+		RS::get_singleton()->free_rid(shader_map[key].shader);
+		shader_map.erase(key);
+		unused_shaders.pop_front();
+		rmmo_shader_evicted++;
+	}
