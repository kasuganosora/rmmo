+// The former deep copies also discarded the parser's spare vector capacity.
+// Keep that compact live footprint while transferring already-tight buffers.
+template <typename T>
+static void rmmo_compact_shader_vector(std::vector<T> &p_vector) {
+	if (p_vector.capacity() != p_vector.size()) {
+		// libstdc++ shrink_to_fit is a no-op when exceptions are disabled.
+		std::vector<T>(p_vector.begin(), p_vector.end()).swap(p_vector);
+	}
+}
+
+static void rmmo_compact_shader_data(respv::Shader &p_shader) {
+	rmmo_compact_shader_vector(p_shader.inlinedSpirvWords);
+	rmmo_compact_shader_vector(p_shader.instructions);
+	rmmo_compact_shader_vector(p_shader.instructionAdjacentListIndices);
+	rmmo_compact_shader_vector(p_shader.instructionInDegrees);
+	rmmo_compact_shader_vector(p_shader.instructionOutDegrees);
+	rmmo_compact_shader_vector(p_shader.instructionOrder);
+	rmmo_compact_shader_vector(p_shader.blocks);
+	rmmo_compact_shader_vector(p_shader.blockPreOrderIndices);
+	rmmo_compact_shader_vector(p_shader.blockPostOrderIndices);
+	rmmo_compact_shader_vector(p_shader.functions);
+	rmmo_compact_shader_vector(p_shader.variableOrder);
+	rmmo_compact_shader_vector(p_shader.results);
+	rmmo_compact_shader_vector(p_shader.specializations);
+	rmmo_compact_shader_vector(p_shader.decorations);
+	rmmo_compact_shader_vector(p_shader.phis);
+	rmmo_compact_shader_vector(p_shader.loopHeaders);
+	rmmo_compact_shader_vector(p_shader.listNodes);
+}
