+#pragma once
+
+#include "core/error/error_list.h"
+#include "core/variant/dictionary.h"
+
+// Optional diagnostic capture. Each native thread is the sole writer of its
+// event chunks. Control/export are main-thread-only, outside the timed window.
+namespace RmmoDebugTrace {
+enum Label {
+	MAIN_ITERATION = 1,
+	RENDER_SYNC,
+	RENDER_DRAW,
+	WORKER_EXECUTE,
+	WORKER_WAIT,
+	RESOURCE_LOAD,
+	MESH_MATERIAL,
+	PIPELINE_WAIT,
+	DEVICE_STALL,
+	VULKAN_FENCE_WAIT,
+	VULKAN_SUBMIT_PRESENT,
+	WORKER_ENQUEUE,
+};
+Error start(int64_t p_event_capacity = 1048576, bool p_cpu_clock = false);
+Dictionary stop();
+Dictionary status();
+Error export_capture(const String &p_path);
+int64_t register_label(const String &p_name);
+uint64_t begin(uint32_t p_label, int64_t p_task = 0, int64_t p_context = 0);
+void end(uint64_t p_span);
+void mark(uint32_t p_label, int64_t p_task = 0, int64_t p_value = 0);
+
+class Scope {
+	uint64_t span;
+public:
+	Scope(uint32_t p_label, int64_t p_task = 0, int64_t p_context = 0) : span(begin(p_label, p_task, p_context)) {}
+	~Scope() { if (span) end(span); }
+	Scope(const Scope &) = delete;
+	Scope &operator=(const Scope &) = delete;
+};
+}
