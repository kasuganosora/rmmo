+void RenderingDeviceGraph::_run_secondary_command_buffer_task(SecondaryCommandBuffer *p_secondary) {
+	if (!driver->command_buffer_begin_secondary(p_secondary->command_buffer, p_secondary->render_pass, 0, p_secondary->framebuffer)) {
+		return; // The main thread will record this list inline instead.
+	}
+	_run_draw_list_command(p_secondary->command_buffer, p_secondary->instruction_data, p_secondary->instruction_data_size);
 	driver->command_buffer_end(p_secondary->command_buffer);
+	p_secondary->recorded = true; // Read only after task completion synchronization.
+}
+
+void RenderingDeviceGraph::_schedule_secondary_command_buffers() {
+	Frame &current_frame = frames[frame];
+	if (current_frame.secondary_command_buffers.is_empty()) {
+		return;
+	}
+	secondary_candidates.clear();
+	for (uint32_t i = 0; i < command_count; ++i) {
+		RecordedCommand *base = reinterpret_cast<RecordedCommand *>(&command_data[command_data_offsets[i]]);
+		if (base->type != RecordedCommand::TYPE_DRAW_LIST) {
+			continue;
+		}
+		RecordedDrawListCommand *draw = static_cast<RecordedDrawListCommand *>(base);
+		// Whole lists retain their complete binding/dynamic state. Small lists,
+		// nested secondary execution and subpass transitions stay inline.
+		if (draw->secondary_eligible && draw->instruction_data_size >= 65536) {
+			secondary_candidates.push_back({ draw });
+		}
+	}
+	secondary_candidates.sort();
+	for (SecondaryCandidate &candidate : secondary_candidates) {
+		if (current_frame.secondary_command_buffers_used == current_frame.secondary_command_buffers.size()) {
+			break;
+		}
+		RecordedDrawListCommand *draw = candidate.command;
+		RDD::RenderPassID render_pass = draw->render_pass;
+		RDD::FramebufferID framebuffer = draw->framebuffer;
+		if (draw->framebuffer_cache != nullptr) {
+			_get_draw_list_render_pass_and_framebuffer(draw, render_pass, framebuffer);
+		}
+		if (!render_pass || !framebuffer) {
+			continue;
+		}
+		uint32_t index = current_frame.secondary_command_buffers_used;
+		SecondaryCommandBuffer &secondary = current_frame.secondary_command_buffers[index];
+		if (!secondary.command_pool || !secondary.command_buffer || !driver->command_pool_reset(secondary.command_pool)) {
+			continue;
+		}
+		secondary.render_pass = render_pass;
+		secondary.framebuffer = framebuffer;
+		secondary.instruction_data = draw->instruction_data();
+		secondary.instruction_data_size = draw->instruction_data_size;
+		secondary.recorded = false;
+		secondary.task = WorkerThreadPool::get_singleton()->add_native_task([](void *p_userdata) {
+			SecondaryCommandBuffer *job = static_cast<SecondaryCommandBuffer *>(p_userdata);
+			job->owner->_run_secondary_command_buffer_task(job);
+		}, &secondary, true, "RenderCommandRecord");
+		if (secondary.task != WorkerThreadPool::INVALID_TASK_ID) {
+			draw->secondary_index = index;
+			++current_frame.secondary_command_buffers_used;
+		}
+	}
 }
 
