+
+// Glyphs are rasterized into the atlas image in place. With a separate render
+// thread a queued texture update reads its image later, so it gets a snapshot.
+static Ref<Image> _glyph_atlas_upload(const Ref<Image> &p_atlas, const Ref<Image> &p_image) {
+	Ref<Image> image = p_image;
+	if (image == p_atlas && !RenderingServer::get_singleton()->is_on_render_thread()) {
+		image = p_atlas->duplicate();
+	}
+	return image;
+}
 
