+static Dictionary _mesh_prepare_surface_from_arrays(RSE::PrimitiveType p_primitive, const Array &p_arrays, const Array &p_blend_shapes, const Dictionary &p_lods, BitField<RSE::ArrayFormat> p_flags) {
+	RenderingServerTypes::SurfaceData surface;
