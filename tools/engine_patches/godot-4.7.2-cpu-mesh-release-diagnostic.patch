+	active = nullptr; // All logging and temporary diagnostic containers are outside the measured scope.
+	static const uint64_t minimum = []() { const char *v = std::getenv("RMMO_RELEASE169_MIN_US"); return v ? uint64_t(std::strtoull(v, nullptr, 10)) : uint64_t(5000); }();
+	reporting = true;
+	if (ended - sample.start < minimum) {
+		for (int i = 0; i < sample.meta_count; i++) { sample.meta_keys[i] = StringName(); }
+		sample.meta_count = 0;
+		reporting = false;
+		return;
+	}
+	Dictionary row;
+	row["object_id"] = String::num_uint64(sample.object_id);
+	row["start_us"] = int64_t(sample.start);
+	row["end_us"] = int64_t(ended);
+	row["total_memdelete_us"] = int64_t(ended - sample.start);
+	row["shape_updates_processed"] = int64_t(sample.shape_updates);
+	row["inclusive_nested_do_not_sum"] = true;
+	row["includes_refcount_unreference"] = false;
+	row["metadata_snapshot_in_predelete"] = true;
+	const char *names[PHASE_COUNT] = { "predelete", "notification", "cleanup_notification", "script_instance_delete", "script_instance_body", "script_instance_mutex_wait", "object_body", "shape_body", "physics_free_rid", "physics_update_shapes", "arraymesh_body" };
+	Dictionary phases;
+	for (int i = 0; i < PHASE_COUNT; i++) {
+		Dictionary phase;
+		phase["us"] = int64_t(sample.us[i]); phase["count"] = int64_t(sample.count[i]);
+		phase["first_offset_us"] = sample.first[i] ? int64_t(sample.first[i] - sample.start) : int64_t(-1);
+		phase["last_offset_us"] = sample.last[i] ? int64_t(sample.last[i] - sample.start) : int64_t(-1);
+		phases[names[i]] = phase;
+	}
+	row["phases"] = phases;
+	row["script_post_body_remainder_us"] = int64_t(sample.us[SCRIPT_DELETE]) - int64_t(sample.us[SCRIPT_BODY]);
+	row["after_object_body_remainder_us"] = sample.last[OBJECT_BODY] ? int64_t(ended - sample.last[OBJECT_BODY]) : int64_t(-1);
+	Array metadata;
+	for (int i = 0; i < sample.meta_count; i++) {
+		Dictionary entry;
+		entry["key"] = String(sample.meta_keys[i]); entry["variant_type"] = sample.meta_types[i];
+		metadata.push_back(entry);
+	}
+	row["metadata_keys_first16"] = metadata;
+	print_line("RMMO_RELEASE169 " + JSON::stringify(row));
+	for (int i = 0; i < sample.meta_count; i++) { sample.meta_keys[i] = StringName(); }
+	sample.meta_count = 0;
+	reporting = false;
+}
+Scope::Scope(Phase p_phase, const void *p_owner) : phase(p_phase) {
+	if (!active) { return; }
+	if ((p_phase == PREDELETE || p_phase == NOTIFY || p_phase == CLEANUP_NOTIFY || p_phase == SCRIPT_DELETE || p_phase == OBJECT_BODY) && p_owner != active->object) { return; }
