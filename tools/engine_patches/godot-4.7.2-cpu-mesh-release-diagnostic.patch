+// Temporary, opt-in destruction attribution. No resource ownership or ordering changes.
+#pragma once
+#include <cstdint>
+class Object;
+class RefCounted;
+class StringName;
+namespace RMMORelease169 {
+enum Phase { PREDELETE, NOTIFY, CLEANUP_NOTIFY, SCRIPT_DELETE, SCRIPT_BODY, SCRIPT_LOCK_WAIT, OBJECT_BODY, SHAPE_BODY, PHYSICS_FREE, SHAPE_UPDATES, ARRAYMESH_BODY, PHASE_COUNT };
+class Root {
+	bool owns = false;
+public:
+	explicit Root(RefCounted *p_object);
+	~Root();
+};
+class Scope {
+	Phase phase;
+	uint64_t started = 0;
+public:
+	explicit Scope(Phase p_phase, const void *p_owner = nullptr);
+	~Scope();
+};
+bool root_is(const void *p_object);
+void metadata_key(const StringName &p_key, int p_type);
+uint64_t script_wait_begin(const void *p_instance);
+void script_wait_end(const void *p_instance, uint64_t p_started);
+void shape_update();
+}
