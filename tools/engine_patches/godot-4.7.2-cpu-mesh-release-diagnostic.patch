+	started = now();
+}
+Scope::~Scope() { if (started) { add(phase, started, now()); } }
+void metadata_key(const StringName &p_key, int p_type) {
+	if (!active || active->meta_count >= 16) { return; }
+	const int at = active->meta_count++;
+	active->meta_keys[at] = p_key; active->meta_types[at] = p_type;
+}
+uint64_t script_wait_begin(const void *p_instance) { return active && active->instance == p_instance ? now() : 0; }
+void script_wait_end(const void *p_instance, uint64_t p_started) {
+	if (active && active->instance == p_instance && p_started) { add(SCRIPT_LOCK_WAIT, p_started, now()); }
+}
+void shape_update() { if (active) { active->shape_updates++; } }
+}
 
