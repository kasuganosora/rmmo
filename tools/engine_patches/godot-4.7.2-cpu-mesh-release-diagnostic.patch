+}
+static uint64_t now() { return OS::get_singleton()->get_ticks_usec(); }
+static void add(Phase p_phase, uint64_t p_start, uint64_t p_end) {
+	if (!active || !p_start) { return; }
+	active->us[p_phase] += p_end - p_start;
+	active->count[p_phase]++;
+	if (!active->first[p_phase]) { active->first[p_phase] = p_start; }
+	active->last[p_phase] = p_end;
+}
+bool root_is(const void *p_object) { return active && active->object == p_object; }
