+void MaterialStorage::shader_prepare_for_material(RID p_shader) {
+	Shader *shader = shader_owner.get_or_null(p_shader);
+	if (!shader || !shader->data || shader->type != SHADER_TYPE_3D) {
+		return;
+	}
+	// No material using this new RID has been registered yet. Waiting here
+	// cannot make _update_queued_materials discover the unfinished owner and
+	// wait on the same ShaderRD version mutex from the render thread.
+	Pair<ShaderRD *, RID> native = shader->data->get_native_shader_and_version();
+	if (native.first && native.second.is_valid()) {
+		native.first->version_is_valid(native.second);
+	}
+}
+
 void MaterialStorage::shader_embedded_set_lock() {
 	embedded_set_mutex.lock();
 }
