extends "res://tools/apply_axel_reference_layout.gd"
## S12-specific assembly using native house deletion, asset placement and roads.
const HOUSE="building_ddf6bf729213bd14c951"
const Imported=preload("res://scripts/world3d/imported_building.gd")
var entry_snapshot:Dictionary={}
var permitted:Dictionary={}
func before_placements(recipe:Dictionary)->void:
	entry_snapshot=editor._doc.recovery_snapshot()
	report.scope="S12 residence, detached courtyard gate, side entrance props and courtyard paths; layout only"
	report.executed_sources={}
	for path:String in ["res://tools/apply_axel_s12_residence.gd","res://tools/apply_axel_reference_layout.gd"]:report.executed_sources[path]=FileAccess.get_sha256(path)
	check(recipe.has("asset_review") and FileAccess.get_sha256(recipe.asset_review.path)==recipe.asset_review.sha256,"exact art handoff reviewed before assembly")
	check(editor._doc.map_meta.building_instances.has(HOUSE),"expected old S12 generic house")
	if failed:return
	for id:String in editor._doc.map_meta.building_instances[HOUSE].parts.values():permitted[id]=true
	permitted.obj_883=true
	await operation("delete_building",{"id":HOUSE})
	await operation("select_objects",{"ids":["obj_883"]})
	await operation("delete_selection",{})
	for id:String in permitted:check(editor._doc._find(id).is_empty(),"old house/arch removed by native operation "+id)
	if failed:return
	for row:Dictionary in recipe.get("pre_moves",[]):
		var record:Dictionary=editor._doc._find(row.id);var box:AABB=Foot.record_shape(record).bounds
		var point:=City.vec(row.point)
		if row.get("grounded",true):point.y=Props.ground(editor._doc,point)-.02
		var at:=City.vec(record.position)+point-Vector3(box.get_center().x,box.position.y,box.get_center().z)
		await operation("set_object_transform",{"id":row.id,"position":City.xyz(at)})
		permitted[row.id]=true
		report.placements.append({"key":row.key,"id":row.id,"position":City.xyz(at),"scale":record.size})
		if failed:return
	# Remove old entry paths before placing the new solid gable. The new graph
	# is regenerated by the same UI/MCP operation, retaining original paving.
	var layout:=await operation("get_city_layout",{})
	var roads:Dictionary=recipe.road_request.duplicate(true)
	roads.expected_token=layout.road_token
	for node:Dictionary in roads.get("nodes",[]):node.position[1]=Props.ground(editor._doc,City.vec(node.position))
	await operation("update_road_graph",roads)
func after_placements(_recipe:Dictionary)->void:
	var doc=editor._doc
	var house:Dictionary={}
	for row:Dictionary in report.placements:
		permitted[row.id]=true
		if row.key=="s12/residence":house=doc._find(row.id)
	check(not house.is_empty() and Imported.verify_source(house),"new residence preserves imported building source identity")
	if failed:return
	var components:=await operation("list_building_components",{"id":house.uuid})
	report.house_components=components
	var roads:Dictionary=editor._roads.prepare({})
	check(roads.get("ok",false),"final full native road and entrance clearance")
	report.road_validation={"ok":roads.get("ok",false),"error":roads.get("error",""),"conflicts":roads.get("conflicts",[])}
	if failed:return
	for id:String in ["obj_33","obj_38"]:
		var gap:=road_gap(doc._find(id));check(gap>=.12,"relocated entire grass footprint clears new paths "+id)
		if not report.has("road_clearance"):report.road_clearance=[]
		report.road_clearance.append({"id":id,"minimum_m":gap})
	# This is scene-reference provenance, not an editor geometry bypass.
	for row:Dictionary in doc.map_meta.town_reference.house_layout.placements:
		if row.get("id","")=="s12_arch_home":
			row.previous_building_id=HOUSE
			for key:String in ["building_id","parameters","component_ids","template_id","terrain_range"]:row.erase(key)
			row.object_id=house.uuid;row.position=house.position;row.rotation=house.rotation
			row.yaw=house.rotation[1];row.entrance=[347.75,8.025,115.3]
			row.label="浅溪左岸长侧入口住宅与独立院门"
			row.component_ids=report.placements.filter(func(p):return p.key in ["s12/residence","s12/courtyard_gate","s12/banner_a","s12/banner_b","s12/jar"]).map(func(p):return p.id)
			row.reference_stage="S12 dedicated residence; scene alignment pending outdoor review"
	report.changed_records=[];report.deleted_records=[];report.new_records=[]
	var old_ids:Dictionary={}
	for old:Dictionary in entry_snapshot.records:
		old_ids[old.uuid]=true
		var now:Dictionary=doc._find(old.uuid)
		if City.token(old)==City.token(now):continue
		check(permitted.has(old.uuid) or old.has("road_mesh"),"change limited to explicit S12 instances or native road derivation "+str(old.uuid))
		if now.is_empty():report.deleted_records.append(old.uuid)
		else:report.changed_records.append(old.uuid)
	for row:Dictionary in doc.records:
		if old_ids.has(row.uuid):continue
		check(permitted.has(row.uuid) or row.has("road_mesh"),"new record has scoped ownership "+str(row.uuid))
		report.new_records.append(row.uuid)
	var old_meta:Dictionary=entry_snapshot.map_meta.duplicate(true);var new_meta:Dictionary=doc.map_meta.duplicate(true)
	old_meta.building_instances.erase(HOUSE)
	for meta:Dictionary in [old_meta,new_meta]:
		meta.editor_layout.erase("roads");meta.editor_layout.erase("road_surface")
		meta.town_reference.house_layout.placements=meta.town_reference.house_layout.placements.filter(func(r):return r.get("id","")!="s12_arch_home")
	check(City.token(old_meta)==City.token(new_meta),"unrelated houses, terrain, water, birth and other metadata unchanged")
