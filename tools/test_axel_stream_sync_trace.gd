extends SceneTree
const Probe=preload("res://tools/profile_axel_stream_sync_trace.gd")
const Stream=preload("res://scripts/world3d/world_stream.gd")
func _initialize()->void:
	assert(Probe.capture_action("bad","white_native_return",false,false)=="invalid_configuration")
	assert(Probe.capture_action("white_native_return","white_native_unload",false,false)=="none")
	assert(Probe.capture_action("white_native_return","white_native_return",false,false)=="start")
	assert(Probe.capture_action("white_native_return","white_native_return",true,false)=="none")
	assert(Probe.capture_action("white_native_return","white_native_reload",true,false)=="stop")
	assert(Probe.capture_action("bad","white_native_return",true,true)=="none")
	assert(Probe.LABELS.has("method.world_stream.sync"))
	assert(Probe.LABELS.has("method.stream_index._retire_plan"))
	var map:=Node.new()
	map.set_meta("profile_frame",true)
	assert(Stream._slow_log_enabled(map))
	map.set_meta("suppress_stream_slow_logs",true)
	assert(not Stream._slow_log_enabled(map))
	assert(map.has_meta("profile_frame"))
	map.remove_meta("suppress_stream_slow_logs")
	assert(Stream._slow_log_enabled(map))
	map.free()
	print("stream sync trace action contract passed")
	quit(0)
