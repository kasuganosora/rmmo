extends "res://tools/test_asset_bounds_manifest.gd"
const Metadata=preload("res://scripts/world3d/asset_source_metadata.gd")
const Memory=preload("res://scripts/world3d/asset_memory_estimate.gd")
const Policy=preload("res://scripts/world3d/runtime_package_policy.gd")
const Trace=preload("res://scripts/world3d/load_trace.gd")
func run()->void:
	var directory:=Paths.cache_directory("metadata_%d"%Time.get_ticks_usec());DirAccess.make_dir_recursive_absolute(directory)
	var path:=directory.path_join("model.glb");write(path,data())
	var expected:=Manifest.read(path);var memory:=Memory.estimate(path)
	var first:=Metadata.read(path,directory)
	check(first.known and not first.metadata_cache_hit,"missing metadata observes source")
	check(first.local_bounds==expected.local_bounds and first.memory==memory,"exact original bounds and full memory reservation")
	Trace.minimum_event_us=0;Trace.start();var cached:=Metadata.read(path,directory);var trace:=Trace.stop()
	check(cached.get("metadata_cache_hit",false),"second read reuses model identity independently of map directory")
	check(cached.local_bounds==expected.local_bounds and cached.memory==memory and cached.json_sha256==expected.json_sha256,"cache roundtrip preserves exact scalar and AABB metadata")
	check(trace.events.all(func(e):return e.label!="model.bounds_manifest"),"hit performs no GLB JSON/accessor traversal")
	var changed:=data();changed.nodes[0].translation=[30,2,0];write(path,changed)
	var replacement:=Metadata.read(path,directory)
	check(not replacement.metadata_cache_hit and replacement.local_bounds!=first.local_bounds,"mutable source replacement invalidates even at same byte length")
	var versioned:=Metadata.read(path,directory,"new geometry contract")
	check(not versioned.metadata_cache_hit and versioned.local_bounds==replacement.local_bounds,"generator change refreshes observation")
	var target:=Metadata.cache_path(Policy.source_identity(path),directory)
	var file:=FileAccess.open(target,FileAccess.WRITE);file.store_buffer(PackedByteArray([0,1,2]));file.close()
	check(not Metadata.read(path,directory).metadata_cache_hit,"truncated cache rebuilds")
	Policy.verify_packages=true
	var diagnostic:=Metadata.read(path,directory)
	check(not diagnostic.has("metadata_cache_hit") and diagnostic.local_bounds==replacement.local_bounds,"explicit diagnostic observes source directly")
	Policy.verify_packages=false
	changed.animations=[{}];write(path,changed)
	check(not Metadata.read(path,directory).known,"unsupported geometry remains unknown")
	print("ASSET_SOURCE_METADATA failures=",failures);quit(1 if failures else 0)
