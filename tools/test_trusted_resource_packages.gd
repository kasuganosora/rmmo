extends SceneTree
const Index=preload("res://scripts/world3d/map_dependency_index.gd")
const Store=preload("res://scripts/world3d/map_resource_store.gd")
const Cursor=preload("res://scripts/world3d/document_open_cursor.gd")
const Policy=preload("res://scripts/world3d/runtime_package_policy.gd")
var failures:=0
var checks:=0
func _initialize()->void:run.call_deferred()
func check(ok:bool,label:String)->void:
	checks+=1;print("PASS " if ok else "FAIL ",label)
	if not ok:failures+=1
func run()->void:
	check(Policy.trusted(),"normal gameplay trusts authored resource packages by default")
	var files:=preload("res://tools/test_map_dependency_index.gd").new()
	files.content_root=Index.Paths.external_root();files.folder=Index.Paths.cache_directory("trusted_package_%d"%Time.get_ticks_usec());DirAccess.make_dir_recursive_absolute(files.folder)
	var roads:=preload("res://tools/test_road_dependency_index.gd").new()
	var records:Array=[roads.road("near",0),roads.road("far",512)];roads.free()
	var source:=files.fixture("map",records)
	var strict:=Cursor.hydrate_references(source.extras,source.path,files.content_root)
	var verified:=Index.build_for_loading(source.path,files.content_root,strict.extras.rmmo_records)
	var baseline:=FileAccess.get_file_as_bytes(Index.cache_path(source.path,files.content_root))
	Store._identities.clear();Store._cache.clear();Store._cache_size=0;Store.reset_definition_cache()
	Index.Trace.minimum_event_us=0;Index.Trace.start()
	var trusted:=Cursor.hydrate_references(source.extras,source.path,files.content_root,4,true)
	var built:=Index.build_for_loading(source.path,files.content_root,trusted.extras.rmmo_records,"",4,Index.Snapshot.RETAIN_LIMIT,true,trusted.definition_sizes)
	var trace:Dictionary=Index.Trace.stop()
	check(trusted.ok and trusted.extras==strict.extras,"trusted reader preserves exact authored records, geometry, references and state")
	check(built.ok and verified.ok and built.index==verified.index,"trusted directory and verified directory have identical rows, bounds, grouping and memory estimates")
	check(baseline==FileAccess.get_file_as_bytes(Index.cache_path(source.path,files.content_root)),"directory bytes and checksum unchanged by runtime authentication policy")
	check(trace.events.filter(func(e):return e.label in ["resource.read_sha","resource.safety","resource.identity_sha","index.build_definition","index.imported_batch"]).is_empty(),"runtime does no resource SHA scan, repeated safety walk, definition re-encoding or imported-source authentication")
	check(Store._identities.is_empty() and Store.definition_cache_stats().entries==0,"trusted reads never seed diagnostic authentication caches")
	var ordinary:=Store.read_records(source.extras.rmmo_records,source.path,files.content_root,source.extras.rmmo_resource_dependencies)
	check(ordinary.ok and not Store._identities.is_empty(),"explicit strict diagnostic reader retains complete validation after trusted read")
	var near:=Index.select(built.index,[AABB(Vector3(-2,-10,-2),Vector3(4,20,4))])
	check(near.ok and near.record_indices==[0] and near.deferred_indices==[1],"trusted package preserves near/far selection and deferred membership")
	var reference:Dictionary=source.extras.rmmo_records[0].rmmo_ref
	var location:String=files.folder.path_join(reference.uri);var bytes:=FileAccess.get_file_as_bytes(location)
	var declared:="1".repeat(64);var alias:String=source.path.get_file()+".resources/"+declared+".rmres"
	var alias_path:String=files.folder.path_join(alias);files.write_bytes(alias_path,bytes);files.created.append(alias_path)
	var compact:Array=[source.extras.rmmo_records[0].duplicate(true)];compact[0].rmmo_ref.sha256=declared;compact[0].rmmo_ref.uri=alias
	var dependencies:Dictionary={alias:declared}
	check(Store.read_records(compact,source.path,files.content_root,dependencies,1,true).ok,"runtime directly accepts declared package identity without recomputing it")
	check(not Store.read_records(compact,source.path,files.content_root,dependencies).ok,"strict package/import reader still rejects incorrect content identity")
	var Writer=preload("res://scripts/world3d/reference_map_save.gd")
	files.write_bytes(source.path,JSON.stringify(Writer.proxy_document(compact,{},dependencies)).to_utf8_buffer())
	Index.Trace.start()
	var editor:=Cursor.new();editor.begin_snapshot(Index.Snapshot.read_file(source.path),true)
	while not editor.done:editor.advance()
	var editor_trace:=Index.Trace.stop()
	check(editor.error.is_empty() and editor.document!=null and editor.document.records==[strict.extras.rmmo_records[0]],"editor and MCP document open also trust declared package references")
	check(editor.metrics.common_records==0 and editor.metrics.document_records==0 and editor_trace.events.filter(func(e):return e.label in ["resource.read_sha","resource.safety","resource.identity_sha"]).is_empty(),"editor open performs no repeated package authentication or semantic record validation")
	check(editor.metrics.layout_validations==0,"editor open does not rerun authored road/layout diagnostics")
	var saved:=Writer.save(source.path,FileAccess.get_sha256(source.path),editor.document.records,editor.document.map_meta,files.content_root,preload("res://scripts/world3d/gltf_map_io.gd"))
	check(saved.error==OK and saved.verified_bytes==0,"editor save creates authored identities without rescanning existing or newly written resource packages")
	files.created.append(source.path+".previous")
	var reopened:=Cursor.new();reopened.begin_snapshot(Index.Snapshot.read_file(source.path),true)
	while not reopened.done:reopened.advance()
	check(reopened.error.is_empty() and reopened.document.records==editor.document.records,"trusted editor save and reopen preserve exact records")
	var saved_sha:=FileAccess.get_sha256(source.path)
	check(Writer.save(source.path,"0".repeat(64),editor.document.records,editor.document.map_meta,files.content_root,preload("res://scripts/world3d/gltf_map_io.gd")).error==ERR_BUSY and FileAccess.get_sha256(source.path)==saved_sha,"map save conflict still has no side effects")
	files.write_bytes(alias_path,bytes.slice(0,bytes.size()-1))
	check(not Store.read_records(compact,source.path,files.content_root,dependencies,1,true).ok,"truncated package returns a load error")
	var invalid:=bytes.duplicate();invalid.encode_u64(8,Store.MAX_RAW_BYTES+1);files.write_bytes(alias_path,invalid)
	check(not Store.read_records(compact,source.path,files.content_root,dependencies,1,true).ok,"decompression allocation stays bounded on trusted path")
	invalid=bytes.duplicate();invalid[0]=0;files.write_bytes(alias_path,invalid)
	check(not Store.read_records(compact,source.path,files.content_root,dependencies,1,true).ok,"unrecognized resource envelope returns a load error")
	DirAccess.remove_absolute(alias_path)
	check(not Store.read_records(compact,source.path,files.content_root,dependencies,1,true).ok,"missing resource returns an explicit load error")
	var model_path:String=files.folder.path_join(declared+".glb");files.write_bytes(model_path,"source bytes".to_utf8_buffer());files.created.append(model_path)
	var parser=preload("res://scripts/world3d/model_parse_preparation.gd")
	var prepared:=parser._source_transaction(model_path,files.content_root,"",func(_path):return {"error":OK},true)
	check(prepared.error==OK and prepared.source_digest==declared,"runtime adopts content-addressed model identity without before/after source scans")
	var collision_identity:=preload("res://scripts/world3d/collision_asset_descriptor.gd")._hash_source(model_path,files.content_root,null)
	check(collision_identity.ok and collision_identity.sha==declared and not collision_identity.hashed,"collision preparation also adopts package identity without scanning model bytes")
	var Deferred=preload("res://scripts/world3d/deferred_asset_loader.gd")
	check(Deferred._manifest_matches(model_path,{"json_sha256":declared,"file_length":1}),"deferred native preparation does not reread package bounds before and after capture")
	var Target=preload("res://scripts/world3d/target_scene_prefetch.gd")
	check(Target.verify({model_path:declared},files.content_root),"cross-map GPU prefetch also trusts the declared model identity")
	check(not Target.verify({source.path:"0".repeat(64)},files.content_root),"cross-map prefetch still invalidates a changed mutable map snapshot")
	check(parser._source_transaction(model_path,files.content_root,declared,func(_path):return {"error":OK}).error==ERR_BUSY,"strict model transaction still detects incorrect declared identity")
	for path:String in files.created:
		if Index.Paths.allowed(path,files.content_root) and FileAccess.file_exists(path):DirAccess.remove_absolute(path)
	DirAccess.remove_absolute(source.path+".resources");DirAccess.remove_absolute(files.folder);files.free()
	print("TRUSTED_RESOURCE_PACKAGES checks=",checks," failures=",failures)
	quit(0 if failures==0 else 1)
