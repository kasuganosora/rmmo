extends "res://tools/test_world3d_mcp.gd"
const T=preload("res://scripts/world3d/terrain_surface.gd")
func run()->void:
	create_timer(120).timeout.connect(func():quit(2))
	var directory:=Paths.cache_directory("terrain_extensions_%d"%Time.get_ticks_usec())
	DirAccess.make_dir_recursive_absolute(directory)
	var path:=directory.path_join("map.gltf");var doc:=Doc.new()
	check(doc.save(path)==OK,"isolated map")
	var session=preload("res://scripts/net/net.gd").session();session.world3d_editor_path=path;session.world3d_editor_doc=null
	editor=preload("res://scripts/world_editor/world_editor.gd").new();editor._mcp_autostart=false;editor._draft_directory=directory.path_join("drafts");root.add_child(editor);await settle()
	while editor._load_job!=null and editor._load_job.active:await process_frame
	var probe:=TCPServer.new();port=30600
	while probe.listen(port,"127.0.0.1")!=OK:port+=1
	probe.stop();check(editor.start_mcp(port).ok,"real HTTP started")
	var definitions:Array=(await rpc("tools/list")).result.tools
	check(definitions.filter(func(t):return t.name=="sculpt_terrain")[0].inputSchema.properties.has("cross_tiles"),"cross tile schema discovered")
	var a:=await call_tool("create_terrain",{"center":[0,0,0],"width":8,"depth":8,"cell_size":1})
	var b:=await call_tool("create_terrain",{"center":[8,0,0],"width":8,"depth":8,"cell_size":1})
	if not a.get("ok",false) or not b.get("ok",false):quit(1);return
	var before:Array=editor._doc.records.duplicate(true);var undo:int=editor._doc._undo.size()
	var args:={"id":a.id,"mode":"raise","points":[[4,0]],"radius":3.,"strength":1.}
	var preview:=await call_tool("preview_terrain_stroke",args)
	check(preview.ok and equivalent(before,editor._doc.records),"multi tile preview no mutation")
	var result:=await call_tool("sculpt_terrain",args)
	check(result.get("changed_ids",[]).size()==2 and editor._doc._undo.size()==undo+1,"both tiles one transaction")
	check(T.sample(editor._doc._find(a.id),Vector3(4,0,0))==1. and T.sample(editor._doc._find(b.id),Vector3(-4,0,0))==1.,"shared edge matches, applied only once")
	await call_tool("undo");check(equivalent(before,editor._doc.records),"undo restores both")
	await call_tool("redo");var after:Array=editor._doc.records.duplicate(true)
	await call_tool("save_world");await call_tool("open_world",{"path":path})
	check(equivalent(after,editor._doc.records),"save reopen retains both grids")
	await call_tool("set_object_properties",{"ids":[b.id],"locked":true})
	before=editor._doc.records.duplicate(true);undo=editor._doc._undo.size()
	var rejected:=await call_tool("sculpt_terrain",args,false)
	check(not rejected.get("ok",true) and equivalent(before,editor._doc.records) and editor._doc._undo.size()==undo,"locked neighbor rejects whole stroke without side effects")
	await call_tool("undo")
	for mode in ["smooth","lower","flatten"]:
		args.mode=mode;args.target_height=.4
		await call_tool("sculpt_terrain",args)
		check(is_equal_approx(T.sample(editor._doc._find(a.id),Vector3(4,0,0)),T.sample(editor._doc._find(b.id),Vector3(-4,0,0))),"seam stays joined "+mode)
	await call_tool("sculpt_terrain",{"id":a.id,"mode":"flatten","points":[[4,0]],"radius":20.,"strength":20.,"hardness":1.,"target_height":0.})
	await call_tool("create_road_path",{"points":[[-3,0,0],[11,0,0]],"width":2.})
	await call_tool("generate_road_surface",{"follow_terrain":true})
	var roads:Array=editor._doc.records.filter(func(r):return r.has("terrain_follow"))
	check(not roads.is_empty() and roads.all(func(r):return r.road_mesh.has("elevations")),"road triangles project onto terrain")
	var recovery:Dictionary=editor._doc.recovery_snapshot()
	await call_tool("sculpt_terrain",{"id":a.id,"mode":"raise","points":[[4,0]],"radius":3.,"strength":.03})
	check(roads!=editor._doc.records.filter(func(r):return r.has("terrain_follow")),"road follows later sculpt in same transaction")
	await call_tool("undo");check(equivalent(recovery.records,editor._doc.records) and equivalent(recovery.map_meta,editor._doc.map_meta),"sculpt undo restores road and generation manifest")
	await call_tool("create_terrain_volume",{"id":"cave","center":[30,4,0],"size":[12,8,12],"resolution":20,"material_id":"pack:default:terrain/icelandic_jagged_slate/material"})
	var carve:={"id":"cave","mode":"subtract","points":[[22,4,0],[38,4,0]],"radius":2.}
	before=editor._doc.records.duplicate(true)
	var volume_preview:=await call_tool("preview_terrain_volume_stroke",carve)
	check(volume_preview.get("triangles",0)>0 and equivalent(before,editor._doc.records),"volume preview no side effects")
	await call_tool("sculpt_terrain_volume",carve)
	var cave:Dictionary=editor._doc._find("cave")
	var volume=preload("res://scripts/world3d/terrain_volume.gd")
	check(volume.field(Vector3.ZERO,Vector3(12,8,12),cave.terrain_volume)>0 and volume.field(Vector3(0,3,0),Vector3(12,8,12),cave.terrain_volume)<0,"horizontal tunnel has empty interior and real ceiling")
	await call_tool("undo");check(equivalent(before,editor._doc.records),"volume stroke undo")
	await call_tool("redo");after=editor._doc.records.duplicate(true)
	await call_tool("save_world");await call_tool("open_world",{"path":path})
	check(equivalent(after,editor._doc.records),"volume save reopen preserves recipe")
	await call_tool("sculpt_terrain_volume",carve.merged({"radius":-1},true),false)
	check(equivalent(after,editor._doc.records),"invalid volume brush no effects")
	await preload("res://tools/extension_physics_fixture.gd").cave(self,editor._doc,check)
	var river_terrain:=await call_tool("create_terrain",{"center":[0,0,35],"width":24,"depth":24,"cell_size":1})
	var river_neighbor:=await call_tool("create_terrain",{"center":[24,0,35],"width":24,"depth":24,"cell_size":1})
	var river_args:={"id":"stream","terrain_ids":[river_terrain.id],"points":[[-10,32],[0,36],[10,32]],"width":4.,"bank_width":2.,"water_level":-.5,"depth":1.5,"natural_materials":true}
	await call_tool("set_object_properties",{"ids":[river_neighbor.id],"locked":true})
	var locked_river:Dictionary=editor._doc.recovery_snapshot()
	await call_tool("generate_terrain_river",river_args,false)
	check(equivalent(locked_river,editor._doc.recovery_snapshot()),"river touching locked neighbor fails atomically")
	await call_tool("undo")
	before=editor._doc.records.duplicate(true)
	await call_tool("preview_terrain_river",river_args)
	check(equivalent(before,editor._doc.records),"river preview no mutation")
	var river:=await call_tool("generate_terrain_river",river_args)
	check(river.get("water_ids",[]).size()>0 and T.sample(editor._doc._find(river_terrain.id),Vector3(0,0,1))< -1.,"curved river carves bed and creates water")
	await call_tool("undo");check(equivalent(before,editor._doc.records),"river undo restores bed and removes water together")
	await call_tool("redo")
	var repeated:Array=editor._doc.records.duplicate(true)
	await call_tool("generate_terrain_river",river_args)
	check(equivalent(repeated,editor._doc.records),"same river request does not deepen bed")
	await call_tool("save_world");after=editor._doc.records.duplicate(true);await call_tool("open_world",{"path":path});check(equivalent(after,editor._doc.records),"road volume and river all survive native reopen")
	if DisplayServer.get_name()!="headless":
		root.size=Vector2i(1600,1000);root.content_scale_size=root.size;editor._grid.hide()
		for shot:Array in [["cave",[30,4,0],16,-10,90],["cave_detail",[30,4,0],7,-8,90],["river",[0,-.5,35],25,-40,15],["river_detail",[0,-.5,35],10,-20,15]]:
			await call_tool("set_editor_camera",{"projection":"perspective","center":shot[1],"distance":shot[2],"pitch":shot[3],"yaw":shot[4]});await settle();await RenderingServer.frame_post_draw
			editor._camera.get_viewport().get_texture().get_image().save_png(directory.path_join(shot[0]+".png"))
	print("TERRAIN_EXTENSIONS_ARTIFACTS ",directory)
	editor._mcp.stop();editor.queue_free();await settle()
	print("CROSS_TILES_FINISHED failures=%d"%failed);quit(1 if failed else 0)
