extends "res://tools/test_world3d_city_layout.gd"

func wait_fall() -> void:
	for i in 600:
		if not editor._gravity.falling: break
		await physics_frame
	check(not editor._gravity.falling, "fall finishes within bounded time")
	await settle()

func run() -> void:
	Engine.max_fps = 60
	root.size = Vector2i(1600, 1000)
	root.content_scale_size = root.size
	directory = Paths.cache_directory("editor_gravity_%d" % Time.get_ticks_usec())
	DirAccess.make_dir_recursive_absolute(directory)
	var path := directory.path_join("map.gltf")
	var doc := Doc.new()
	doc.add_box_silent("ground", Vector3(0, -.1, 0), Vector3(40, .2, 40))
	doc.add_box_silent("block", Vector3(3, 2, 0), Vector3(.1, 4, 8))
	doc.add_box_silent("block", Vector3(-5, 1, 0), Vector3(3, 2, 3))
	doc.add_box_silent("block", Vector3(3,2,10), Vector3(.1,4,8))
	var pair_a := doc.add_box_silent("block", Vector3(1.8,.25,9), Vector3.ONE*.5)
	var pair_b := doc.add_box_silent("block", Vector3(1.8,.25,11), Vector3.ONE*.5)
	doc._find(pair_a).editor_group="gravity_pair"; doc._find(pair_b).editor_group="gravity_pair"
	var box := doc.add_box_silent("block", Vector3(0, 5, 0), Vector3(1, 1, 2))
	check(doc.save(path) == OK, "temporary fixture saved")
	var session = preload("res://scripts/net/net.gd").session()
	session.world3d_editor_doc = doc; session.world3d_editor_path = path
	editor = preload("res://scripts/world_editor/world_editor.gd").new()
	editor._mcp_autostart = false; editor._draft_directory = directory.path_join("drafts")
	root.add_child(editor); editor._safety.enabled = false
	await settle(); await physics_frame
	var probe := TCPServer.new()
	while probe.listen(port, "127.0.0.1") != OK: port += 1
	probe.stop(); check(editor.start_mcp(port).ok, "real 3D HTTP starts")
	var definitions: Array = (await rpc("tools/list")).result.tools
	check(definitions.any(func(t): return t.name == "settle_selection"), "gravity operation discovered over HTTP")
	check(not editor._gravity.enabled, "gravity defaults off")
	await atomic_reject("configure_transform", {"gravity_placement":"yes"})
	await call_tool("configure_transform", {"gravity_placement":true})
	check(editor._gravity_toggle.button_pressed, "HTTP setting updates visible checkbox")
	await call_tool("select_objects", {"ids":[box]})
	var before: Array = doc.records.duplicate(true)
	var undos: int = doc._undo.size()
	await call_tool("settle_selection")
	check(editor._gravity.falling and float(doc._find(box).position[1]) > 1, "release starts visible falling rather than teleporting")
	await call_tool("set_object_transform", {"id":box,"position":[1,1,1]}, false)
	await wait_fall()
	print("LANDING ",doc._find(box).position)
	check(absf(float(doc._find(box).position[1]) - .5) < .015, "whole box rests on ground without embedding")
	check(doc._undo.size() == undos + 1, "one undo owns the complete fall")
	await call_tool("undo")
	check(equivalent(before, doc.records), "undo restores exact pre-fall document")
	await call_tool("redo")
	await call_tool("set_object_transform", {"id":box,"position":[10,.5,0]})
	check(float(doc._find(box).position[0]) < 2.46 and float(doc._find(box).position[0]) > 2.35, "large move stops before thin wall instead of tunnelling")
	await call_tool("undo")
	# Put the elongated prop near the wall, then rotate through it.
	await call_tool("set_object_transform", {"id":box,"position":[2.3,.5,0]})
	await call_tool("set_object_transform", {"id":box,"rotation":[0,90,0]})
	check(float(doc._find(box).rotation[1]) < 40 and float(doc._find(box).rotation[1]) > 0, "rotation stops along its swept path before a wall")
	check(editor._gravity.clear_pose([doc._find(box)]), "accepted rotated pose is nonoverlapping")
	# Reposition with mode disabled, then test a rotated/scaled prop landing on a table.
	await call_tool("configure_transform", {"gravity_placement":false})
	await call_tool("set_object_transform", {"id":box,"position":[-5,6,0],"rotation":[0,35,20],"size":[1.5,.8,1.1]})
	await call_tool("configure_transform", {"gravity_placement":true})
	await call_tool("settle_selection"); await wait_fall()
	var bounds := Geometry.bounds([doc._find(box)])
	check(absf(bounds.position.y - 2) < .015, "tilted scaled prop lands on tabletop using its lowest corner")
	# Cancellation preserves records and history; invalid no-floor is atomic.
	await call_tool("configure_transform", {"gravity_placement":false})
	await call_tool("set_object_transform", {"id":box,"position":[0,8,0],"rotation":[0,0,0],"size":[1,1,2]})
	before = doc.records.duplicate(true); undos = doc._undo.size()
	await call_tool("settle_selection")
	editor._gravity.complete(true)
	check(equivalent(before,doc.records) and undos == doc._undo.size(), "cancel midfall restores document without undo pollution")
	await call_tool("set_object_transform", {"id":box,"position":[100,8,0]})
	await atomic_reject("settle_selection", {})
	await call_tool("set_object_transform", {"id":box,"position":[3,1,0]})
	await atomic_reject("settle_selection", {})
	# Exercise the actual gizmo transaction, not only the numeric API.
	await call_tool("set_object_transform", {"id":box,"position":[0,5,0]})
	await call_tool("configure_transform", {"gravity_placement":true,"mode":"move","position_snap":0})
	await call_tool("set_editor_camera", {"center":[0,2,0],"distance":18,"yaw":30,"pitch":-30})
	before = doc.records.duplicate(true); undos = doc._undo.size()
	var origin: Vector3 = editor._selection_tools.pivot()
	var from: Vector2 = editor._camera.unproject_position(origin)
	var to: Vector2 = editor._camera.unproject_position(origin + Vector3.RIGHT)
	check(editor._transform_drag.begin(editor,from,0), "real gizmo drag begins")
	editor._transform_drag.update(to,true)
	check(float(doc._find(box).position[0]) > .9, "gizmo previews horizontal move")
	editor._transform_drag.finish()
	check(editor._gravity.falling, "gizmo mouse release transfers into fall")
	await wait_fall()
	check(doc._undo.size() == undos + 1, "drag and fall share exactly one undo")
	await call_tool("undo")
	check(equivalent(before,doc.records), "drag undo restores position before mouse-down")
	await call_tool("select_objects", {"ids":[pair_a,pair_b]})
	before = doc.records.duplicate(true)
	await call_tool("transform_selection", {"rotation":[0,90,0]})
	var separation := Geometry.vector(doc._find(pair_a),"position").distance_to(Geometry.vector(doc._find(pair_b),"position"))
	check(absf(separation-2)<.0001,"blocked group rotation preserves rigid member spacing")
	check(float(doc._find(pair_a).rotation[1])>0 and float(doc._find(pair_a).rotation[1])<90,"group rotation stops before wall")
	await call_tool("undo")
	check(equivalent(before,doc.records),"group collision-limited transform undoes exactly")
	# New palette items have the same validated placement path through HTTP.
	var list: Dictionary = await call_tool("list_assets")
	var modules: Array = list.assets.filter(func(a): return a.get("asset_id","") == "bridge_4")
	check(not modules.is_empty(), "built-in palette module is discoverable")
	if not modules.is_empty():
		var key: String = modules[0].asset_id
		before = doc.records.duplicate(true); undos = doc._undo.size()
		var created: Dictionary = await call_tool("place_asset", {"asset_id":key,"position":[-10,5,8]})
		await wait_fall()
		if created.has("ids"):
			check(absf(Geometry.bounds([doc._find(created.ids[0])]).position.y) < .015, "new item drops from air onto ground")
		check(doc._undo.size() == undos + 1, "adding and dropping creates one undo")
		await call_tool("undo")
		check(equivalent(before,doc.records), "undo removes complete added item")
		await call_tool("redo")
		await call_tool("undo")
		var next_id: int = doc._next
		var redos: int = doc._redo.size()
		await call_tool("place_asset", {"asset_id":key,"position":[-10,10,8]})
		editor._gravity.complete(true)
		check(equivalent(before,doc.records) and undos == doc._undo.size() and redos == doc._redo.size() and next_id == doc._next, "cancel new item restores records, identity counter, undo and redo")
		await atomic_reject("place_asset", {"asset_id":key,"position":[100,5,0]})
		await atomic_reject("place_asset", {"asset_id":key,"position":[3,1,0]})
	# A real GLB and a two-member captured prefab use the same placement path.
	var model := Node3D.new()
	var mesh := MeshInstance3D.new(); mesh.mesh = BoxMesh.new(); mesh.position = Vector3(.4,1,0)
	model.add_child(mesh)
	var gltf := GLTFDocument.new(); var gltf_state := GLTFState.new()
	var model_path := directory.path_join("offset_prop.glb")
	check(gltf.append_from_scene(model,gltf_state)==OK and gltf.write_to_filesystem(gltf_state,model_path)==OK, "create private GLB with off-center pivot")
	model.free()
	var library = preload("res://scripts/world_editor/asset_library.gd").new(directory.path_join("assets"))
	var imported: Dictionary = library.import_file(model_path)
	check(imported.ok, "import isolated GLB fixture")
	editor._shared_assets.append(library)
	if imported.ok:
		editor._refresh_palette()
		await call_tool("set_editor_camera", {"projection":"top","center":[0,0,0],"span":40})
		await physics_frame; await settle()
		var pixel: Vector2 = editor._camera.unproject_position(Vector3(-10,0,10))
		before = doc.records.duplicate(true)
		editor._drop_palette(pixel, {"type":"rmmo_palette","entry":imported.entry})
		await wait_fall()
		check(doc.records.size()==before.size()+1 and absf(Geometry.bounds([doc.records.back()]).position.y)<.015,"real palette drop places the imported model on ground")
		await call_tool("undo")
		check(equivalent(before,doc.records),"palette drop undo restores prior document")
		var key: String = editor._mcp._ops.asset_id(imported.entry)
		var added: Dictionary = await call_tool("place_asset", {"asset_id":key,"position":[-10,4,-8]})
		await wait_fall()
		if added.has("ids"):
			var asset: Dictionary = doc._find(added.ids[0])
			check(absf(Geometry.bounds([asset]).position.y)<.015, "GLB pivot offset is accounted for when landing")
			var copies: Array = [asset.duplicate(true),asset.duplicate(true)]
			copies[1].uuid="fixture_second"; copies[1].position[0] += 2
			var prefab: Dictionary = preload("res://scripts/world_editor/prefab_library.gd").capture(copies,library,"重力组合测试")
			check(prefab.ok,"capture isolated two-member prop prefab")
			if prefab.ok:
				before = doc.records.duplicate(true); undos = doc._undo.size()
				var placed: Dictionary = await call_tool("place_asset", {"asset_id":editor._mcp._ops.asset_id(prefab.entry),"position":[-10,6,-4]})
				await wait_fall()
				if placed.has("ids"):
					var parts: Array = placed.ids.map(func(id): return doc._find(id))
					check(parts.size()==2 and absf(Geometry.bounds(parts).position.y)<.015, "prefab members land together without colliding with themselves")
				check(doc._undo.size()==undos+1,"prefab placement is one undo")
				await call_tool("undo")
				check(equivalent(before,doc.records),"prefab undo removes the whole addition")
	await call_tool("select_objects", {"ids":[box]})
	await call_tool("set_object_properties", {"ids":[box],"locked":true})
	await atomic_reject("settle_selection", {})
	await call_tool("undo")
	await call_tool("select_objects", {"ids":[box]})
	await call_tool("set_object_transform", {"id":box,"position":[0,8,0]})
	await call_tool("settle_selection")
	check(editor._save(), "save completes pending fall safely")
	check(not editor._gravity.falling and absf(float(doc._find(box).position[1])-.5)<.015, "save cannot capture a half-fallen object")
	var saved: Array = doc.records.duplicate(true)
	await call_tool("open_world", {"path":path})
	check(equivalent(saved,editor._doc.records), "save and reopen retain grounded position")
	await call_tool("set_editor_camera", {"projection":"perspective","center":[0,1,0],"distance":20,"pitch":-30,"yaw":30})
	await settle(); await RenderingServer.frame_post_draw
	var screenshot := directory.path_join("gravity_editor_ui.png")
	check(root.get_texture().get_image().save_png(screenshot)==OK,"capture avatar-free UI verification")
	print("GRAVITY_UI ",screenshot)
	editor.queue_free(); await settle()
	print("EDITOR_GRAVITY_PLACEMENT failures=", failed)
	quit(0 if failed == 0 else 1)
