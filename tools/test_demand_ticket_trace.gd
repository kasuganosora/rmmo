extends "res://tools/test_deferred_typed_demand_scan.gd"
## Run in the diagnostic overlay generated by prepare_demand_ticket_overlay.py.

func ticket_counts()->void:
	var q:=Deferred.new()
	var a:=item("a",0);a.group_id="g"
	var b:=item("b",1);b.group_id="g"
	var p:=item("published",2);p.group_id="g";p.published=true
	var support:=item("support",9000)
	q.pending=[a,b,p,support]
	q.register_runtime_building("a",a.bounds,{"support":true})
	var clip:=AABB(Vector3(-5,-1,-5),Vector3(10,2,10))
	q._demands={"first":{"group_id":"g","kind":"all","priority":1,"clip":clip},"second":{"group_id":"g","kind":"all","priority":0,"clip":clip}}
	check(q._demand_ticket_trace==null,"ticket diagnostics off by default")
	q.start_demand_ticket_trace(16);q._refresh_demanded()
	var events:Array=q.demand_ticket_trace_snapshot().events
	check(events.size()==2,"one event per actual ticket")
	if events.size()==2:
		var first:Dictionary=events[0];var second:Dictionary=events[1]
		check(first.id=="first" and first.input_rows==4 and first.kind_excluded==1 and first.published==1 and first.new_uuid==2 and first.duplicate_uuid==0,"first ticket partitions every source row")
		check(first.support_visits==1 and first.winner_changes==0,"first ticket separately counts support visits and no prior winner changes")
		check(second.id=="second" and second.input_rows==4 and second.kind_excluded==1 and second.published==1 and second.duplicate_uuid==2 and second.new_uuid==0 and second.winner_changes==2 and second.support_visits==1,"overlap, stronger priority, and support visits counted independently")
		check(first.membership_uuid_sequence_changed==null and first.origin_changed==null and first.priority_changed==null,"first observation does not invent prior state")
	q._demand_revision+=1;q._refresh_demanded();q._demand_revision+=1;q._refresh_demanded()
	events=q.demand_ticket_trace_snapshot().events
	check(events.size()==6 and events[4].membership_cache_hit and events[4].membership_uuid_sequence_changed==false and events[4].origin_changed==false and events[4].priority_changed==false,"stable cached ticket reports exact unchanged sequence and rank inputs")
	q._demands.first.priority=-1;q._demands.first.clip=AABB(clip.position+Vector3(10,0,0),clip.size);q._demand_revision+=1;q._refresh_demanded()
	events=q.demand_ticket_trace_snapshot().events
	check(events[6].priority_changed==true and events[6].origin_changed==true,"priority and origin changes are independently reported")
	q.stop_demand_ticket_trace();check(q._demand_ticket_trace==null,"stop releases diagnostic")
	q.free()

func bounded_test()->void:
	var trace=preload("res://tools/diagnostics/demand_ticket_trace.gd").new(1)
	var t:Dictionary=trace.begin_ticket("x",Vector3.ZERO,0,0,false,2,0)
	trace.member(t,{"uuid":"a".repeat(129)});trace.end_ticket(t,0)
	check(not trace.snapshot().events[0].complete_members and trace.snapshot().events[0].membership_uuid_sequence_changed==null,"oversize UUID makes comparison unknown, not false")
	check(trace.begin_ticket("y",Vector3.ZERO,0,1,false,0,0)==null and trace.snapshot().dropped==1,"event limit explicitly counts omitted tickets")
	trace=preload("res://tools/diagnostics/demand_ticket_trace.gd").new(2)
	for iteration:int in 2:
		t=trace.begin_ticket("x",Vector3.ZERO,0,iteration,false,513,0)
		for i:int in 513:trace.member(t,{"uuid":str(i)})
		trace.end_ticket(t,0)
	check(not trace.snapshot().events[1].complete_members and trace.snapshot().events[1].membership_uuid_sequence_changed==null,"oversize memberships are bounded and never claim equality")
	trace=preload("res://tools/diagnostics/demand_ticket_trace.gd").new(2)
	t=trace.begin_ticket("missing",Vector3.ZERO,0,0,false,1,0);trace.member(t,null);trace.end_ticket(t,0)
	t=trace.begin_ticket("missing",Vector3.ZERO,0,1,false,1,0);trace.member(t,{"uuid":123});trace.end_ticket(t,0)
	check(not trace.snapshot().events[0].complete_members and not trace.snapshot().events[1].complete_members and trace.snapshot().events[1].membership_uuid_sequence_changed==null,"missing/non-string UUID on filtered input never throws or claims equal membership")
	trace=preload("res://tools/diagnostics/demand_ticket_trace.gd").new(130)
	for i:int in 129:
		t=trace.begin_ticket(str(i),Vector3.ZERO,0,i,false,1,0);trace.member(t,{"uuid":str(i)});trace.end_ticket(t,0)
	t=trace.begin_ticket("0",Vector3.ZERO,0,130,false,1,0);trace.member(t,{"uuid":"0"});trace.end_ticket(t,0)
	var bounded:Dictionary=trace.snapshot()
	check(bounded.tracked_tickets==128 and bounded.evicted==2 and bounded.untracked==0 and bounded.events.back().membership_uuid_sequence_changed==null,"LRU eviction remains bounded and reappearing ticket comparison is unknown")

func equivalence_test()->void:
	var without:=Deferred.new();var with_trace:=Deferred.new();var rows:Array=[]
	for i:int in 64:rows.append(item("row_%d"%i,float(i*4),1,"shared_%d"%(i%7)))
	without.pending=rows.duplicate();with_trace.pending=rows.duplicate();with_trace.start_demand_ticket_trace(1024)
	var same:=true
	for step:int in 32:
		var point:=Vector3(float(step*5),float(step%4),0)
		var clip:=AABB(point-Vector3(15,2,15),Vector3(30,4,30))
		for queue:Deferred in [without,with_trace]:
			queue.prioritize(point);queue.set_demand("mixed",clip,-1)
			if step%5==0:queue.set_demand_scope(["mixed","player"])
			if step%5==2:queue.set_demand_scope([])
			if step%7==0:queue.release_demand("mixed")
			queue._refresh_demanded()
		same=same and snapshot(without)==snapshot(with_trace) and without._demanded.size()==with_trace._demanded.size()
		for i:int in mini(without._demanded.size(),with_trace._demanded.size()):same=same and is_same(without._demanded[i],with_trace._demanded[i])
	check(same,"diagnostic preserves exact paths, ranking and owner identities for movement, scope and release")
	without.free();with_trace.free()

func run()->void:
	var logger:=Errors.new();OS.add_logger(logger)
	ticket_counts();bounded_test();equivalence_test()
	OS.remove_logger(logger);check(logger.errors.is_empty(),"zero engine/script errors")
	for issue:String in logger.errors:print("ENGINE_ERROR ",issue)
	print("DEMAND_TICKET_TRACE passed=",passed," failures=",failed);quit(0 if failed==0 else 1)
