extends RefCounted
## Immutable native products published by import/conversion, never generated by
## a map load. Runtime reads bounded metadata, then only the requested mip data.
const Paths=preload("res://scripts/world3d/map_paths.gd")
const Product=preload("res://scripts/world3d/streamed_texture_product.gd")
const Atomic=preload("res://scripts/world3d/atomic_file.gd")
const FORMATS=[Image.FORMAT_RGBA8,Image.FORMAT_DXT1,Image.FORMAT_DXT5,Image.FORMAT_RGTC_RG]

static func enabled()->bool:
	return ClassDB.class_exists("StreamedTexture2D") and Engine.has_singleton("TextureStreaming") and bool(ProjectSettings.get_setting("rendering/textures/streaming/enabled",false)) and RenderingServer.get_current_rendering_method()!="gl_compatibility"

static func descriptor_path(path:String,flip:bool,normal:bool,compressed:bool)->String:
	return path+".rmmo-stream-"+("normal-flipped" if flip else ("normal" if normal else "color"))+("-dds" if compressed else "-source")+".json"

static func _mip_sizes(width:int,height:int,format:int)->Array[int]:
	var result:Array[int]=[]
	while true:
		result.append(width*height*4 if format==Image.FORMAT_RGBA8 else maxi(1,(width+3)/4)*maxi(1,(height+3)/4)*(8 if format==Image.FORMAT_DXT1 else 16))
		if width==1 and height==1:break
		width=maxi(1,width/2);height=maxi(1,height/2)
	return result

static func _cancelled(token:RefCounted)->bool:return token!=null and token.is_cancelled()

static func publish(path:String,image:Image,source_sha:String,representation:String,root:String,flip:bool=false,normal:bool=false,token:RefCounted=null)->Error:
	# Caller owns the prepared pixels and lease, including mip generation and
	# any requested lossy encoding. No source read, codec or GPU call here.
	if image==null or image.is_empty() or source_sha.is_empty() or representation.is_empty() or (flip and not normal):return ERR_INVALID_PARAMETER
	if not Paths.allowed(path,root):return ERR_FILE_BAD_PATH
	if image.get_format() not in FORMATS:return ERR_UNAVAILABLE
	if image.get_width()>16384 or image.get_height()>16384 or image.get_data_size()>0xffffffff:return ERR_UNAVAILABLE
	var sizes:=_mip_sizes(image.get_width(),image.get_height(),image.get_format())
	if image.get_mipmap_count()+1!=sizes.size():return ERR_INVALID_DATA
	var identity:=var_to_bytes([1,source_sha,representation,flip,normal,image.get_width(),image.get_height(),image.get_format()]).hex_encode().sha256_text()
	var descriptor:=descriptor_path(path,flip,normal,image.is_compressed())
	var product:=path.get_base_dir().path_join(identity+".stex")
	var staging:=product+".tmp-%d-%d-%d"%[OS.get_process_id(),OS.get_thread_caller_id(),Time.get_ticks_usec()]
	if not Paths.allowed(product,root) or not Paths.allowed(staging,root) or not Paths.allowed(descriptor,root) or not Paths.allowed(descriptor+".previous",root):return ERR_FILE_BAD_PATH
	if _cancelled(token):return ERR_SKIP
	if not FileAccess.file_exists(product):
		var file:=FileAccess.open(staging,FileAccess.WRITE)
		if file==null:return FileAccess.get_open_error()
		var error:=Product.write(file,image);file.close()
		if error==OK and not _cancelled(token):error=Atomic.publish_new(staging,product)
		elif _cancelled(token):error=ERR_SKIP
		if FileAccess.file_exists(staging):DirAccess.remove_absolute(staging)
		if error not in [OK,ERR_ALREADY_EXISTS]:return error
	# Publish the descriptor last. Old live textures keep their immutable file;
	# a cancelled conversion can leave an unadvertised disposable product only.
	if _cancelled(token):return ERR_SKIP
	var alpha:bool=image.get_meta("runtime_upload_has_alpha") if image.has_meta("runtime_upload_has_alpha") else image.detect_alpha()!=Image.ALPHA_NONE
	var metadata:={"version":1,"file":product.get_file(),"source_sha256":source_sha,"representation":"stex:"+identity,
		"normal":normal,"flip":flip,"alpha":alpha,"width":image.get_width(),"height":image.get_height(),"format":image.get_format(),"bytes":image.get_data_size()}
	var encoded:=JSON.stringify(metadata).to_utf8_buffer()
	var existing:=FileAccess.open(descriptor,FileAccess.READ)
	if existing!=null:
		var same:bool=existing.get_length()==encoded.size() and existing.get_buffer(encoded.size())==encoded
		existing.close()
		if same:return OK
	staging=descriptor+".tmp-%d-%d-%d"%[OS.get_process_id(),OS.get_thread_caller_id(),Time.get_ticks_usec()]
	if not Paths.allowed(staging,root):return ERR_FILE_BAD_PATH
	var file:=FileAccess.open(staging,FileAccess.WRITE)
	if file==null:return FileAccess.get_open_error()
	var wrote:=file.store_buffer(encoded);file.close()
	var error:Error=ERR_SKIP if _cancelled(token) else (Atomic.publish(staging,descriptor) if wrote else ERR_FILE_CANT_WRITE)
	if FileAccess.file_exists(staging):DirAccess.remove_absolute(staging)
	return error

static func plan(path:String,flip:bool,normal:bool,root:String)->Dictionary:
	# Mutable editor snapshots retain their full-source preparation route. A
	# mounted package trusts its published references, with no new source hash.
	if not enabled() or not preload("res://scripts/world3d/runtime_package_policy.gd").trusted() or (flip and not normal):return {}
	if root.is_empty() or not Paths.allowed(path,root):return {}
	var compressed:bool=preload("res://scripts/world3d/surface_materials.gd").compressed_sidecars_enabled and not preload("res://scripts/world3d/compressed_texture_source.gd").sidecar_path(path,flip,normal).is_empty()
	var descriptor:=descriptor_path(path,flip,normal,compressed)
	if not Paths.allowed(descriptor,root):return {}
	var file:=FileAccess.open(descriptor,FileAccess.READ)
	if file==null or file.get_length()>4096:return {}
	var data:Variant=JSON.parse_string(file.get_as_text());file.close()
	if not data is Dictionary or data.get("version")!=1 or data.get("normal")!=normal or data.get("flip")!=flip or not data.get("alpha") is bool:return {}
	var name:Variant=data.get("file")
	if not name is String or name.is_empty() or name!=name.get_file() or not name.ends_with(".stex"):return {}
	if not data.get("representation") is String or not data.representation.begins_with("stex:"):return {}
	for field:String in ["width","height","format","bytes"]:
		var value:Variant=data.get(field)
		if not (value is int or value is float) or not is_finite(value) or value<0 or value>0xffffffff or value!=int(value):return {}
	var width:=int(data.width);var height:=int(data.height);var format:=int(data.format)
	if width<1 or height<1 or width>16384 or height>16384 or format not in FORMATS:return {}
	if compressed!=(format!=Image.FORMAT_RGBA8) or (format==Image.FORMAT_RGTC_RG and not normal):return {}
	var product:=path.get_base_dir().path_join(name)
	if not Paths.allowed(product,root):return {}
	file=FileAccess.open(product,FileAccess.READ)
	if file==null:return {}
	var sizes:=_mip_sizes(width,height,format)
	var full_bytes:=0
	for size:int in sizes:full_bytes+=size
	var header_size:=44+8*sizes.size()
	if full_bytes!=int(data.bytes) or file.get_length()!=header_size+full_bytes:return {}
	var header:=file.get_buffer(header_size);file.close()
	if header.size()!=header_size or header.slice(0,4).get_string_from_ascii()!="GSTF" or header.decode_u32(4)!=Product.FORMAT_VERSION:return {}
	if header.decode_u32(8)!=width or header.decode_u32(12)!=height or header.decode_u32(16)!=full_bytes or header.decode_u32(20)!=format or header.decode_u32(24)!=sizes.size()-1:return {}
	var offset:=0
	for mip:int in sizes.size():
		if header.decode_u32(28+mip*8)!=offset or header.decode_u32(32+mip*8)!=sizes[mip]:return {}
		offset+=sizes[mip]
	# This publisher has no per-file overrides/detection callbacks. Reject a
	# changed layout before admission rather than under-reserving its load.
	for field:int in 4:
		if header.decode_u32(header_size-16+field*4)!=0:return {}
	return {"path":path,"flip":flip,"normal":normal,"root":root,"extension":"stex","product":product,
		"width":width,"height":height,"format":format,"source_bytes":header_size+full_bytes,"output_bytes":full_bytes,
		"alpha":data.alpha,"representation":data.representation,"mip_sizes":sizes}

static func read(row:Dictionary,digest:String)->Texture2D:
	var texture:Texture2D=ClassDB.instantiate("StreamedTexture2D")
	if texture==null or texture.call("load",row.product)!=OK:return null
	texture.set_meta("runtime_source_sha256",digest)
	texture.set_meta("runtime_texture_representation",row.representation)
	texture.set_meta("surface_has_alpha",row.alpha)
	texture.set_meta("runtime_normal_xy",row.format==Image.FORMAT_RGTC_RG)
	# Full-chain conservative cache charge, not measured dynamic GPU residency.
	texture.set_meta("runtime_upload_bytes",row.output_bytes)
	return texture
